# Lichtblicke Bestattung – Apache-Konfiguration für den Strato-Webspace
# (wird beim Build unverändert nach _site/.htaccess kopiert)

AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

RewriteEngine On

# HTTPS und www in einer einzigen 301-Weiterleitung erzwingen
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.lichtblicke-bestattung.de%{REQUEST_URI} [R=301,L]

# Browser-Caching: Schriften/Bilder lange (ändern sich selten), CSS/JS mittel
# (werden per ?v=… gebustet), HTML immer frisch
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
